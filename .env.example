# =============================================================================
# ARES AI — Environment Configuration
# Copy this file to .env and fill in REAL values before any production run.
# NEVER commit .env to version control.
# Reference: docs/SETUP.md, docs/AUTH_SECURITY.md, docs/DEPLOYMENT.md
#
# ╔═════════════════════════════════════════════════════════════════════════╗
# ║  AUTHENTICATION IS REQUIRED IN EVERY ENVIRONMENT                      ║
# ║  Set API_SECRET_KEY to a unique value before the first run. The        ║
# ║  shipped placeholder is rejected (503) on every non-public route.      ║
# ║                                                                        ║
# ║  PRODUCTION REQUIREMENT                                               ║
# ║  If ENVIRONMENT=production, ALL of the following MUST be overridden:   ║
# ║    - API_SECRET_KEY                                                    ║
# ║    - JWT_SECRET_KEY                                                    ║
# ║    - POSTGRES_PASSWORD (referenced in DATABASE_URL)                    ║
# ║                                                                        ║
# ║  The application will refuse to start if any of these still contain    ║
# ║  the literal string "changeme_in_production" in production mode.       ║
# ╚═════════════════════════════════════════════════════════════════════════╝
# =============================================================================

# --- Runtime environment ---
# Set to "production" to enable production-safety checks.
# Leave as "development" (default) for local work.
# ENVIRONMENT=production

# --- Database (PostgreSQL 16+) ---
POSTGRES_USER=ares
POSTGRES_PASSWORD=changeme_in_production    # <-- MUST change in production
POSTGRES_DB=ares_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- ChromaDB ---
# When running the backend inside Docker (docker compose up): CHROMA_HOST=chromadb, CHROMA_PORT=8000
# When running the backend on your host machine against dockerized infra (dev):
#   CHROMA_HOST=localhost, CHROMA_PORT=8001 (published port from the container)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=ares_memories

# --- OpenRouter (primary LLM provider) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenCode (LLM fallback provider) ---
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://api.opencode.ai/v1

# --- Local OpenAI-compatible LLM (opt-in, chat-first) ---
# Set true only while a local server (Strata) is running. No API key is needed.
# The dev Compose stack publishes the backend on host 8080, so run the local
# model on another host port (8081 here) and reach it through host.docker.internal.
# The root stack uses 8000, so 8081 works there too. Host-run backend:
# use http://127.0.0.1:8080/v1 instead.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://host.docker.internal:8081/v1
LOCAL_LLM_TIMEOUT_SECONDS=90
# The local model serves one generation at a time; the gate is process-wide.
LOCAL_LLM_MAX_CONCURRENT=1
LOCAL_LLM_QUEUE_TIMEOUT_SECONDS=20

# --- Analysis pipeline controls ---
# One full pipeline can make many LLM requests and can reach paper execution.
# The gate is process-wide: extra /analyze or /analyze/stream starts return 429
# instead of queueing unbounded background tasks. /signal waits up to the queue
# timeout before returning 429. On the free tier the run count is the unit of
# model spend; the rolling hourly budget bounds it. ANALYSIS_TIMEOUT_SECONDS is
# a stage-start deadline: it is checked before each LLM stage, and cleared once
# execution begins so a committed fill is never cancelled by a timeout.
ANALYSIS_MAX_CONCURRENT=1
ANALYSIS_TIMEOUT_SECONDS=300
ANALYSIS_MAX_RUNS_PER_HOUR=30
ANALYSIS_QUEUE_TIMEOUT_SECONDS=5
# Number of per-session results retained for /agents/status?session_id=...
ANALYSIS_STATE_CACHE_SIZE=64

# --- API Server ---
# Local single-user default: bind to loopback only. Use 0.0.0.0 inside Docker
# or when you intentionally expose the API on a trusted network.
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
# REQUIRED for every non-public route. The shipped default is rejected at
# request time (503). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=changeme_in_production       # <-- MUST change before first run
JWT_SECRET_KEY=changeme_in_production       # <-- MUST change in production
API_RATE_LIMIT_PER_MINUTE=100

# --- Login brute-force protection ---
# Maximum failed login attempts per (email + IP) in the window
LOGIN_RATE_LIMIT_ATTEMPTS=5
# Window in seconds for the (email + IP) limit (300 = 5 minutes)
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Maximum failed login attempts per IP alone (prevents email rotation)
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
# Window in seconds for the IP-only limit (900 = 15 minutes)
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=900
# Comma-separated list of trusted reverse proxy IPs.
# Only needed when behind a load balancer / nginx that sets X-Forwarded-For.
# Leave empty when clients connect directly to the API server.
TRUSTED_PROXIES=

API_CORS_ORIGINS=http://localhost:3000

# --- Trading ---
PAPER_TRADING_INITIAL_CAPITAL=100000.0
# Decimal fractions, not percentages: 0.001 = 10 bps per side.
PAPER_TRADING_COMMISSION_PCT=0.001
PAPER_TRADING_SLIPPAGE_PCT=0.001
# Seconds a paper write waits for the cross-process advisory lock before failing
# closed (HTTP 503, Retry-After: 1). Keep well above one candle cycle.
PAPER_TRADING_WRITER_LOCK_TIMEOUT_SECONDS=10.0
KILL_SWITCH_ENABLED=true
DEFAULT_TRADING_MODE=human_approval
# Position sizing is enforced in code (agents/risk.py, 2% of paper equity); it
# is deliberately not environment-configurable.
MAX_DRAWDOWN_PCT=20.0
# Paper-only default. Live start/execution refuse to run unless this is
# explicitly true AND every live gate passes (kill switch, mode, promotion).
LIVE_TRADING_ENABLED=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Exchange: Coinbase ---
COINBASE_API_KEY=
COINBASE_SECRET_KEY=

# --- Exchange: Kraken ---
KRAKEN_API_KEY=
KRAKEN_SECRET_KEY=

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
HEALTH_CHECK_INTERVAL_SECONDS=30
