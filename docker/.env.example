# =============================================================================
# ARES AI — Docker Compose Environment
# Copy to .env and fill in secrets.
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_USER=ares
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=ares_ai

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── Backend (FastAPI) ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ares:changeme_in_production@postgres:5432/ares_ai
REDIS_HOST=redis
REDIS_PORT=6379
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_SECRET_KEY=changeme_in_production
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ─── Frontend (Next.js) ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_STANDALONE=true
