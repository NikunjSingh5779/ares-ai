{
  "__inputs": [],
  "__requires": [],
  "title": "ARES AI — Trading Dashboard",
  "uid": "ares-ai",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["ares-ai", "trading"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Kill Switch Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "ares_live_kill_switch_active",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              { "value": 0, "color": "#22c55e" },
              { "value": 1, "color": "#ef4444" }
            ]
          }
        }
      }
    },
    {
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "rate(ares_requests_total[5m])",
          "legendFormat": "{{method}} {{endpoint}}"
        }
      ]
    },
    {
      "title": "Agent Runs by Agent",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "ares_agents_runs_total",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "title": "Live Orders by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "rate(ares_live_orders_total[5m])",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Agent Fallback Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "rate(ares_agents_fallback_total[5m])",
          "legendFormat": "{{agent}} → {{to_model}}"
        }
      ]
    },
    {
      "title": "Request Duration (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(ares_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(ares_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(ares_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
