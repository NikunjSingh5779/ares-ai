{
  "__inputs": [],
  "__requires": [],
  "title": "ARES AI — Platform Overview",
  "uid": "ares_overview",
  "version": 1,
  "schemaVersion": 36,
  "tags": ["ares", "trading"],
  "timezone": "browser",
  "editable": false,
  "panels": [
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=\"ares-backend\"}",
          "legendFormat": "Backend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 7, "x": 3, "y": 0 },
      "targets": [
        {
          "expr": "rate(ares_requests_total[1m])",
          "legendFormat": "{{method}} {{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Request Latency (p50)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 7, "x": 10, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(ares_request_duration_seconds_bucket[1m]))",
          "legendFormat": "{{method}} {{endpoint}} p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Request Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 7, "x": 17, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(ares_request_duration_seconds_bucket[1m]))",
          "legendFormat": "{{method}} {{endpoint}} p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Request Latency (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 7, "x": 3, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(ares_request_duration_seconds_bucket[1m]))",
          "legendFormat": "{{method}} {{endpoint}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Status Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 7, "x": 10, "y": 8 },
      "targets": [
        {
          "expr": "sum by (status) (ares_requests_total)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Agent Runs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(ares_agents_runs_total[5m])",
          "legendFormat": "{{agent}} ({{status}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Agent Fallbacks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "rate(ares_agents_fallback_total[5m])",
          "legendFormat": "{{agent}}: {{from_model}} → {{to_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Live Trading — Kill Switch",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "ares_live_kill_switch_active",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "title": "Live Orders",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "rate(ares_live_orders_total[5m])",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Agent Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "rate(ares_agents_runs_total{status=\"error\"}[5m]) / rate(ares_agents_runs_total[5m]) * 100",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "showPoints": "never" }
        }
      }
    }
  ]
}
